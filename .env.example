DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,newsapp-server-u11s.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=
NEWS_API_KEY=
NEWS_DATA_IO_API_KEY=
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4o-mini
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google web OAuth client (server-only; same client on frontend and backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional account recovery (SMTP; configure a verified sender)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=AbokiNews <support@your-verified-domain.com>
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000

# Server-only full article preparation (requires OPENAI_API_KEY above).
ARTICLE_WRITING_MODEL=gpt-4o-mini

# Independent source-support verifier (server only).
ARTICLE_REVIEW_MODEL=gpt-4.1-mini
ARTICLE_REVISION_MODEL=gpt-4.1-mini
