{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python scripts/build-worker-site.py",
  "outputDirectory": "worker-site",
  "redirects": [
    {
      "source": "/api/:path*",
      "destination": "https://newsapp-server-8zzq.onrender.com/api/:path*",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://newsapp-server-8zzq.onrender.com/admin/:path*",
      "permanent": false
    },
    {
      "source": "/health/:path*",
      "destination": "https://newsapp-server-8zzq.onrender.com/health/:path*",
      "permanent": false
    }
  ],
  "daemons": {
    "news-worker": {
      "root": ".",
      "entrypoint": "Dockerfile.worker",
      "instances": {
        "iad1": 1
      },
      "terminationGracePeriodSeconds": 3600
    }
  },
  "ignoreCommand": "python scripts/ignore-docs-build.py"
}
